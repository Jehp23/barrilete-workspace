{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [
    14,
    14
  ],
  "preview": "layouts/bk-lavanda.svg",
  "theme": { "light": "bk-dia", "dark": "bk-neon" },
  "ui_font": "SF Mono",
  "background": "canvas",
  "terminal_padding": [
    10,
    14
  ],
  "terminal_opacity": 0,
  "resizable": false,
  "children": [
    {
      "id": "body",
      "type": "row",
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "size": {
            "px": 288
          },
          "min": 76,
          "max": 420,
          "background": "chrome",
          "resizable": false,
          "children": [
            {
              "id": "brand",
              "type": "block",
              "size": {
                "px": 40
              },
              "window_drag": true,
              "content": {
                "mod": "bk-marca"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "bk-agentes"
              }
            },
            {
              "id": "sidebar-footer",
              "type": "block",
              "size": {
                "px": 36
              },
              "content": {
                "mod": "bk-marca",
                "props": {
                  "footer": true
                }
              }
            }
          ]
        },
        {
          "id": "work",
          "type": "column",
          "resizable": false,
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "size": {
                "px": 40
              },
              "window_drag": true,
              "content": {
                "mod": "bk-pestanas"
              }
            },
            {
              "id": "work-body",
              "type": "row",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "padding": [
                    8,
                    0
                  ],
                  "content": {
                    "tab": "active",
                    "pane": {
                      "gap": 8,
                      "radius": 10,
                      "background": "background",
                      "lone": true,
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "input"
                      },
                      "header": {
                        "content": {
                          "mod": "bk-cabecera"
                        },
                        "height": 30,
                        "position": "top",
                        "reveal": "always"
                      }
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "hidden": true,
                  "size": {
                    "px": 360
                  },
                  "min": 280,
                  "max": 900,
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "active": "files",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "files"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "mod": "changes"
                          }
                        }
                      ]
                    }
                  ],
                  "padding": [
                    8,
                    0
                  ]
                },
                {
                  "id": "lado",
                  "type": "block",
                  "size": {
                    "px": 304
                  },
                  "min": 240,
                  "max": 520,
                  "content": {
                    "mod": "bk-lado"
                  }
                }
              ],
              "padding": [
                0,
                8
              ],
              "gap": 8
            }
          ]
        }
      ]
    },
    {
      "id": "status",
      "type": "block",
      "size": {
        "px": 26
      },
      "content": {
        "mod": "bk-barra"
      }
    }
  ]
}
