{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "python3 \"$(git rev-parse --path-format=absolute --git-common-dir)/../lib/land.py\" hook" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "python3 \"$(git rev-parse --path-format=absolute --git-common-dir)/../lib/land.py\" hook" }]
      }
    ]
  }
}
